meta {
  name: MANTRA Backend API
  type: http
}

vars:pre-request {
  baseUrl: http://localhost:8080/api/v1
  accessToken: 
  publicId: 
}

headers {
  Content-Type: application/json
  Accept: application/json
}

auth:bearer {
  token: {{accessToken}}
}

script:pre-request {
  // Auto-refresh logic dapat ditambahkan di sini
  // Jika response 401, call /auth/refresh dan set token baru
}

docs {
  # MANTRA Backend API

  API Collection untuk backend service MANTRA.

  ## Setup

  1. Aktifkan environment `local`
  2. Login via `Auth > Login` untuk mendapatkan access token
  3. Token otomatis terisi di collection-level auth

  ## Base URL

  Semua request menggunakan variable `{{baseUrl}}`:
  - Local: http://localhost:8080/api/v1
}
