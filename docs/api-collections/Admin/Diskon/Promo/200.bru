meta {
  name: 200
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/diskon
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

script:post-response {
  const body = res.getBody();
  if(body && body.data && body.data.length > 0) {
    const lastIndex = body.data.length - 1;
    const pId = body.data[lastIndex].public_id;
    bru.setVar("diskon_public_id", pId);
    bru.setEnvVar("diskon_public_id", pId);
  }
}
