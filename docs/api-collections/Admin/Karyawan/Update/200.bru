meta {
  name: 200
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/admin/karyawan/:publicId
  body: json
  auth: bearer
}

params:path {
  publicId: {{karyawan_public_id}}
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nama_lengkap": "Karyawan Updated",
    "shift": "Siang"
  }
}
