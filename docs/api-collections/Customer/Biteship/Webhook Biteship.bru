meta {
  name: Webhook Biteship
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/webhook/biteship
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Biteship-Signature: {{biteshipWebhookSignature}}
}

body:json {
  {
    "event": "order.status",
    "data": {
      "id": "{{biteshipOrderId}}",
      "waybill_id": "{{waybillId}}",
      "status": "active"
    }
  }
}

script:post-response {
  bru.log(`Webhook received: ${res.body?.status}`);
}