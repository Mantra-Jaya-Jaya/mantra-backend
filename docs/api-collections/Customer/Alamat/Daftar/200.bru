meta {
  name: 200
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/customer/alamat
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  X-Client-Type: flutter
}

script:post-response {
  const body = res.getBody();
  if (body && body.data && body.data.length > 0 && body.data[0].id_alamat) {
    bru.setVar("customer_alamat_id", body.data[0].id_alamat);
  }
}
