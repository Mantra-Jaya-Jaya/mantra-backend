meta {
  name: Update
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/customer/alamat/{{idAlamat}}
  body: json
  auth: bearer
}

params:path {
  idAlamat: 1
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "nama_penerima": "John Updated",
    "label_alamat": "Kantor",
    "is_utama": false
  }
}
