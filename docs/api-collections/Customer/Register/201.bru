meta {
  name: 201
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Client-Type: flutter
}

body:json {
  {
    "username": "customer{{$randomInt}}",
    "email": "customer{{$randomInt}}@example.com",
    "password": "password123",
    "konfirmasi_password": "password123",
    "nama_lengkap": "Customer Baru",
    "no_telp": "0812{{$randomInt}}"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.data && body.data.username) {
    bru.setVar("registeredUsername", body.data.username);
  }
  if (body && body.data && body.data.email) {
    bru.setVar("registeredEmail", body.data.email);
  }
}
