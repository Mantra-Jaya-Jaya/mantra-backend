meta {
  name: 200
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/customer/ongkir/cek
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  X-Client-Type: flutter
}

body:json {
  {
    "id_alamat": "{{customer_alamat_id}}",
    "items": [
      {
        "id_spesifikasi_barang": 1,
        "quantity": 2
      }
    ]
  }
}
