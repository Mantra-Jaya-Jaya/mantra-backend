meta {
  name: 200
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  X-Client-Type: flutter
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

script:post-response {
  const token = res.body.data?.access_token;
  if (token) {
    bru.setVar("accessToken", token);
    bru.setEnvVar("accessToken", token);
  }
  const refresh = res.body.data?.refresh_token;
  if (refresh) {
    bru.setVar("refreshToken", refresh);
    bru.setEnvVar("refreshToken", refresh);
  }
}
