meta {
  name: 422
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  X-Client-Type: flutter
}

body:json {
  {
    "password_lama": "Customer#123",
    "password_baru": "CustomerBaru#456",
    "konfirmasi_password": "mismatched_confirmation"
  }
}
