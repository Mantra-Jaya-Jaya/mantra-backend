put {
  url: {{baseUrl}}/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
  X-Client-Type: flutter
}

body:json {
  {
    "password_lama": "SalahPassword#999",
    "password_baru": "CustomerBaru#456",
    "konfirmasi_password": "CustomerBaru#456"
  }
}
