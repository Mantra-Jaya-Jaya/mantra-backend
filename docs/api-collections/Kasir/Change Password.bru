meta {
  name: Change Password
  type: http
  seq: 98
}

put {
  url: {{baseUrl}}/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "password_lama": "oldpassword123",
    "password_baru": "newpassword123",
    "konfirmasi_password": "newpassword123"
  }
}
